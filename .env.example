# ---- Supabase (publishable / public config — safe to show as an example) ----
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ---- Groq (server-side secret) ----
# NEVER expose this through a VITE_ variable or any frontend/client code.
# Only read it inside server functions / server routes via process.env['GROQ_API_KEY'].
# Add the real value in Project Settings → Secrets — do not commit real keys here.
GROQ_API_KEY=your_groq_api_key_here
